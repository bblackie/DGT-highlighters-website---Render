-- All highlighters
SELECT * FROM Highlightersnew;

-- All highlighters and the brands
SELECT Brandsnew.Name, Highlightersnew.Name FROM Highlightersnew
JOIN Brandsnew ON Brandsnew.BrandID = Highlightersnew.BrandID;

-- Highlighters of one brand
SELECT Highlightersnew.Name FROM Highlightersnew
JOIN Brandsnew ON Brandsnew.BrandID = Highlightersnew.BrandID
WHERE Brandsnew.Name = 'Stabilo';

-- Just the ID, brand, name and ImageURL1
SELECT Highlightersnew.HighlighterID, Brandsnew.Name, Highlightersnew.Name, Highlightersnew.ImageURL1 
FROM Highlightersnew
JOIN Brandsnew ON Brandsnew.BrandID = Highlightersnew.BrandID;

-- just one highlighter based on the id
SELECT * FROM Highlightersnew JOIN Brandsnew ON Brandsnew.BrandID=Highlightersnew.BrandID 
WHERE Highlightersnew.HighlighterID = 2;


SELECT Highlightersnew.HighlighterID, Brandsnew.Name, Highlightersnew.Name, Highlightersnew.ImageURL1 
FROM Highlightersnew
JOIN Brandsnew ON Brandsnew.BrandID = Highlightersnew.BrandID;

SELECT Highlightersnew.Name, Brandsnew.Name, Highlightersnew.Cost, Highlightersnew.Description 
FROM Highlightersnew 
JOIN Brandsnew ON Brandsnew.BrandID=Highlightersnew.BrandID 
WHERE Highlightersnew.HighlighterID = 2;